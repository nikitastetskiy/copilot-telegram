# Copy this file to `.env` (same directory as copilot_watcher.py) and fill in.
# `.env` is loaded automatically at startup; shell env vars take precedence.

# Required ---------------------------------------------------------------------

# From @BotFather: /mybots → pick bot → API Token → reveal/regenerate
BOT_TOKEN=

# Your Telegram user/chat id (e.g. from @userinfobot)
CHAT_ID=

# Optional ---------------------------------------------------------------------

# Default window-name filter for the picker (skipped if you pass a CLI arg).
TARGET_WINDOW_NAME=

# Path to write the prompt screenshot before uploading to Telegram.
# SCREENSHOT_PATH=~/.copilot_prompt.png

# DEBUG / INFO / WARNING
# LOG_LEVEL=INFO
